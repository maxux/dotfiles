# Customize panes borders
set -g pane-border-style "fg=#555555"
set -g pane-active-border-style "fg=#ffffff,bold"

# Improve status bar
set -g status on
set -g status-interval 30

set -g status-justify left
set -g status-left-length 0

# Enable powerline hardcoded
set -g @left-out-power '#[bg=#0a2224,fg=#216fb5] '

set -g @win-in-power "#[bg=#0a2224,fg=#aaaaaa,noattr]" # 
set -g @win-act-in-power "#[bg=#0a2224,fg=#ffffff,bold]" # 

set -g @win-out-power '#[bg=#0a2224,fg=#ffffff]'

set -g @right-in-power '#[bg=#0a2224,fg=#41778a,bold]'
set -g @hour-in-power '#[bg=#41778a,fg=#3e51a3]'

set -g @date-style '#[bg=#41778a,fg=#ffffff]'
set -g @hour-style '#[bg=#3e51a3,fg=#eeeeee,bold]'

set -g @window-status-fmt "[#I] #{pane_title} #{?window_flags,#{window_flags}, }"

set -g status-style "fg=white,bg=#0a2224"

set -g window-status-format "#{@win-in-power}#{E:@window-status-fmt} #{@win-out-power}"
set -g window-status-current-format "#{@win-act-in-power}#{E:@window-status-fmt} #{@win-out-power}"

set -g status-left '#[bg=#216fb5,fg=#ffffff,bold] - #S - #{@left-out-power}'
set -g status-right '#{@right-in-power}#{@date-style} %d %b #{@hour-in-power}#{@hour-style} %H:%M '

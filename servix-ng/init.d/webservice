#!/sbin/openrc-run
# Maxux Web Services startup script

description="Run a Web Service on Maxux Stack."

: ${WEBSRV_USER:=nobody}
: ${WEBSRV_UID:="$(id -u ${WEBSRV_USER})"}
: ${WEBSRV_HOME:="/home/${WEBSRV_USER}"}
: ${WEBSRV_ROOTDIR:="${WEBSRV_HOME}"}
: ${WEBSRV_SERVICE:="${RC_SVCNAME%.*}"}
: ${WEBSRV_INSTANCE="${RC_SVCNAME##*.}"}
: ${WEBSRV_MODULES:=()}
: ${WEBSRV_PIDFILE_DIR:="/run/${WEBSRV_SERVICE}"}
: ${WEBSRV_PIDFILE:=${WEBSRV_PIDFILE_DIR}/${WEBSRV_INSTANCE}.pid}
: ${WEBSRV_TMUX_SOCKET:="/tmp/tmux-${WEBSRV_UID}/default"}

command="/usr/bin/tmux"
command_args="new-session -s ${WEBSRV_INSTANCE} -c ${WEBSRV_ROOTDIR} -x 270 -y 70 -d"
command_user="${WEBSRV_USER}:${WEBSRV_USER}"
pidfile="${WEBSRV_PIDFILE}"

command_socket="${command} -S ${WEBSRV_TMUX_SOCKET}"

extra_commands="session forcestop"

depend() {
	after local
	use localmount
}

start_pre() {
	checkpath -d -m 0755 -o 0:0 "${WEBSRV_PIDFILE_DIR}"

	# Restarting service, skipping already running check
	[ "${RC_CMD}" = "restart" ] && return 0

	einfo "Checking instance environment: ${WEBSRV_INSTANCE}"
	if session_is_running; then
		eerror "Instance session is already running: ${WEBSRV_INSTANCE}"
		return 1
	fi
}

start() {
	local modlen=${#WEBSRV_MODULES[@]}
	local modlimit=$((${modlen} - 1))

	ebegin "Starting webservice instance: ${WEBSRV_INSTANCE}"

	# Start new empty session
	session_create || return 1

	# Initialize the right amount of pane
	session_panes_spawn ${modlen}

	# Start each module on dedicated pane
	eindent

	for pane in $(seq 0 ${modlimit}); do
        einfo "Running on pane #${pane}: ${WEBSRV_MODULES[$pane]}"

        ${command_socket} select-pane -t ${WEBSRV_INSTANCE}.${pane}
        ${command_socket} send-keys -t ${WEBSRV_INSTANCE} "${WEBSRV_MODULES[$pane]}" ENTER
    done

	eoutdent
	eend 0
}

session_create() {
	start-stop-daemon --start --exec "${command}" \
		--user ${command_user} \
		-- ${command_args}

	return $?
}

session_pane_split_vertical() {
	${command_socket} split-window -t ${WEBSRV_INSTANCE} -c ${WEBSRV_ROOTDIR} -v $@
}

session_pane_split_horizontal() {
	${command_socket} split-window -t ${WEBSRV_INSTANCE} -c ${WEBSRV_ROOTDIR} -h $@
}

session_panes_select_layout() {
	${command_socket} select-layout -t ${WEBSRV_INSTANCE} $@
}

session_pane_split_column() {
	for a in $(seq 1 $1); do
		session_pane_split_vertical -l 50%
	done

	session_panes_select_layout -E
}

# $1 = lines on col1, $2 = lines on col2
session_pane_split_cols() {
	local col1=$(($1 - 1))
	local col2=$(($2 - 1))

	session_pane_split_column ${col1}
	session_pane_split_horizontal -f
	session_pane_split_column ${col2}
}

session_panes_spawn() {
	local length=$1

	# Nothing more to do it there is only one pane
	[ $length -lt 2 ] && return 0

	if [ $length -eq 2 ]; then
		session_pane_split_vertical

	elif [ $length -lt 6 ]; then
		# 3: 1 | 2
		# 4: 1 | 3
		# 5: 1 | 4
		session_pane_split_cols 1 $(($length - 1))

	elif [ $length -eq 6 ]; then
		session_pane_split_cols 2 4

	elif [ $length -eq 7 ]; then
		session_pane_split_cols 3 4

	elif [ $length -eq 8 ]; then
		session_pane_split_cols 4 4

	elif [ $length -eq 9 ]; then
		session_pane_split_cols 5 4
	fi
}

session_server_pid() {
	result=$(${command_socket} list-session -F "#S.#{pid}" | grep "^${WEBSRV_INSTANCE}")
	[[ $? -gt 0 ]] && return 1

	echo ${result##*.}
	return 0
}

session_is_running() {
	${command_socket} list-session -F "#S" 2>&1 | grep -q "^${WEBSRV_INSTANCE}$"
	return $?
}

session_manually_sigint() {
	einfo "Stopping panes processes"

	for paneid in $(${command_socket} list-panes -t ${WEBSRV_INSTANCE} -F "#{session_name}.#{pane_id}"); do
		${command_socket} select-pane -t "${paneid}"
		${command_socket} send-keys -t ${WEBSRV_INSTANCE} "C-c"
	done
}

session_kill() {
	${command_socket} kill-session -t "${WEBSRV_INSTANCE}" > /dev/null 2>&1
	return $?
}

session() {
	ebegin "Checking for existing session: ${WEBSRV_INSTANCE}"
	session_is_running
	eend $?
}

forcestop() {
	ebegin "Force stopping session: ${WEBSRV_INSTANCE}"
	session_kill
	eend $?
}

stop() {
	ebegin "Stopping webservice instance: ${WEBSRV_INSTANCE}"
	session_manually_sigint
	session_kill
	eend $?
}

status_pre() {
	if session_is_running; then
		# Force status started if session is running
		mark_service_started
	else
		mark_service_stopped
	fi
}
